<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recycler_view_item_destination_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/padding_big">

    <TextView
        android:id="@+id/fee_label_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="@dimen/padding_small"
        android:text="@string/recycler_view_item_transaction_destination_pending_summary_fee_label"
        android:textSize="16sp"
        android:textColor="@color/text_subtler" />

    <TextView
        android:id="@+id/fee_textview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fee_label_textview"
        android:layout_marginTop="@dimen/padding_mini"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/dust_label_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fee_textview"
        android:layout_marginTop="@dimen/padding_small"
        android:text="@string/recycler_view_item_transaction_destination_pending_summary_dust_label"
        android:textSize="16sp"
        android:textColor="@color/text_subtler" />

    <TextView
        android:id="@+id/dust_textview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dust_label_textview"
        android:layout_marginTop="@dimen/padding_mini"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/total_label_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dust_textview"
        android:layout_marginTop="@dimen/padding_small"
        android:text="@string/recycler_view_item_transaction_destination_pending_summary_total_label"
        android:textSize="16sp"
        android:textColor="@color/text_subtler" />

    <TextView
        android:id="@+id/total_textview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/total_label_textview"
        android:layout_marginTop="@dimen/padding_mini"
        android:textSize="20sp" />
</androidx.constraintlayout.widget.ConstraintLayout>
