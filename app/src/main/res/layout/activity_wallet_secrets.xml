<?xml version="1.0" encoding="utf-8" ?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none"
    tools:context="org.monfluo.wallet.activity.ActivityWalletSettings">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/activity_wallet_secrets_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_big">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header_layout_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:paddingBottom="@dimen/padding_big"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/back_imageview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:minHeight="32dp"
                android:minWidth="32dp"
                android:src="@drawable/left"
                android:contentDescription="@string/content_description_back" />

            <TextView
                android:id="@+id/header_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/back_imageview"
                app:layout_constraintTop_toTopOf="@id/back_imageview"
                app:layout_constraintBottom_toBottomOf="@id/back_imageview"
                android:text="@string/wallet_secrets_header"
                android:textSize="@dimen/text_bigger"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimary" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header_layout_view">

            <TextView
                android:id="@+id/copy_secrets_warning_label_textview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/copy_secrets_warning"
                android:textColor="#f80"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/seed_header_textview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/wallet_seed_label"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/seed_type_button"
                app:layout_constraintTop_toBottomOf="@id/copy_secrets_warning_label_textview" />

            <Button
                android:id="@+id/seed_type_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/button_small_background"
                tools:text="SEED TYPE"
                android:textSize="12sp"
                app:layout_constraintStart_toEndOf="@id/seed_header_textview"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/seed_header_textview"
                app:layout_constraintBottom_toBottomOf="@id/seed_header_textview" />

            <TextView
                android:id="@+id/legacy_seed_apply_seed_offset_passphrase_textview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/apply_seed_offset_passphrase"
                android:textSize="16sp"
                android:textColor="?attr/colorOnPrimary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/legacy_seed_apply_seed_offset_passphrase_switch"
                app:layout_constraintTop_toTopOf="@id/legacy_seed_apply_seed_offset_passphrase_switch"
                app:layout_constraintBottom_toBottomOf="@id/legacy_seed_apply_seed_offset_passphrase_switch" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/legacy_seed_apply_seed_offset_passphrase_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                app:layout_constraintStart_toEndOf="@id/legacy_seed_apply_seed_offset_passphrase_textview"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/seed_type_button" />

            <TextView
                android:id="@+id/legacy_seed_offset_passphrase_description_label_textview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wallet_seed_offset_legacy_seed_desc"
                android:textColor="#f80"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/legacy_seed_apply_seed_offset_passphrase_switch" />

            <EditText
                android:id="@+id/legacy_seed_offset_passphrase_edittext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/edittext_background"
                android:hint="@string/seed_offset_passphrase"
                android:minHeight="32dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/legacy_seed_offset_passphrase_description_label_textview" />

            <TextView
                android:id="@+id/seed_description_label_textview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wallet_seed_desc"
                android:textColor="#f00"
                android:textSize="12sp"
                app:layout_constraintVertical_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/legacy_seed_offset_passphrase_edittext" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/seed_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/seed_description_label_textview">

                <TextView
                    android:id="@+id/seed_textview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="@dimen/text_medium"
                    android:textColor="?attr/colorOnPrimary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/copy_seed_imagebutton"
                    app:layout_constraintTop_toTopOf="@id/copy_seed_imagebutton"
                    app:layout_constraintBottom_toBottomOf="@id/copy_seed_imagebutton"
                    tools:text="SEED" />

                <ImageButton
                    android:id="@+id/copy_seed_imagebutton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/copy_seed"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:src="@drawable/ic_content_copy_24dp"
                    app:layout_constraintStart_toEndOf="@id/seed_textview"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/polyseed_offset_passphrase_description_label_textview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wallet_seed_offset_polyseed_desc"
                android:textColor="#f80"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/seed_layout" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/polyseed_offset_passphrase_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/polyseed_offset_passphrase_description_label_textview">

                <TextView
                    android:id="@+id/polyseed_offset_passphrase_textview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="@dimen/text_medium"
                    android:textColor="?attr/colorOnPrimary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/copy_polyseed_offset_passphrase_imagebutton"
                    app:layout_constraintTop_toTopOf="@id/copy_polyseed_offset_passphrase_imagebutton"
                    app:layout_constraintBottom_toBottomOf="@id/copy_polyseed_offset_passphrase_imagebutton"
                    tools:text="SEED OFFSET PASSPHRASE" />

                <ImageButton
                    android:id="@+id/copy_polyseed_offset_passphrase_imagebutton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/copy_polyseed_offset_passphrase"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:src="@drawable/ic_content_copy_24dp"
                    app:layout_constraintStart_toEndOf="@id/polyseed_offset_passphrase_textview"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/wallet_restore_height_header_textview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/wallet_restore_height_label"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/polyseed_offset_passphrase_layout" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/restore_height_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/wallet_restore_height_header_textview">

                <TextView
                    android:id="@+id/restore_height_textview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="@dimen/text_medium"
                    android:textColor="?attr/colorOnPrimary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/copy_restore_height_imagebutton"
                    app:layout_constraintTop_toTopOf="@id/copy_restore_height_imagebutton"
                    app:layout_constraintBottom_toBottomOf="@id/copy_restore_height_imagebutton"
                    tools:text="RESTORE HEIGHT" />

                <ImageButton
                    android:id="@+id/copy_restore_height_imagebutton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/copy_restore_height"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:src="@drawable/ic_content_copy_24dp"
                    app:layout_constraintStart_toEndOf="@id/restore_height_textview"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/wallet_adjusted_restore_height_header_textview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/wallet_adjusted_restore_height_label"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/restore_height_layout" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/adjusted_restore_height_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/wallet_adjusted_restore_height_header_textview">

                <TextView
                    android:id="@+id/adjusted_restore_height_textview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="@dimen/text_medium"
                    android:textColor="?attr/colorOnPrimary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/copy_adjusted_restore_height_imagebutton"
                    app:layout_constraintTop_toTopOf="@id/copy_adjusted_restore_height_imagebutton"
                    app:layout_constraintBottom_toBottomOf="@id/copy_adjusted_restore_height_imagebutton"
                    tools:text="ADJUSTED RESTORE HEIGHT" />

                <ImageButton
                    android:id="@+id/copy_adjusted_restore_height_imagebutton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/copy_restore_height"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:src="@drawable/ic_content_copy_24dp"
                    app:layout_constraintStart_toEndOf="@id/adjusted_restore_height_textview"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/wallet_address_header_textview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/wallet_address"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/adjusted_restore_height_layout" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/wallet_address_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/wallet_address_header_textview">

                <TextView
                    android:id="@+id/wallet_address_textview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:textSize="@dimen/text_medium"
                    android:textColor="?attr/colorOnPrimary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/copy_wallet_address_imagebutton"
                    app:layout_constraintTop_toTopOf="@id/copy_wallet_address_imagebutton"
                    app:layout_constraintBottom_toBottomOf="@id/copy_wallet_address_imagebutton"
                    tools:text="ADDRESS" />

                <ImageButton
                    android:id="@+id/copy_wallet_address_imagebutton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/copy_wallet_s_address"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:src="@drawable/ic_content_copy_24dp"
                    app:layout_constraintStart_toEndOf="@id/wallet_address_textview"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/keys_textview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/wallet_keys_label"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/wallet_address_layout" />

            <TextView
                android:id="@+id/wallet_secret_view_key_header_textview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/private_view_key"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/keys_textview"
                app:layout_constraintVertical_bias="0.0" />

            <TextView
                android:id="@+id/wallet_secret_view_key_textview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textSize="@dimen/text_medium"
                android:textColor="?attr/colorOnPrimary"
                app:layout_constraintBottom_toBottomOf="@id/copy_wallet_secret_view_key_imagebutton"
                app:layout_constraintEnd_toStartOf="@id/copy_wallet_secret_view_key_imagebutton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/copy_wallet_secret_view_key_imagebutton"
                tools:text="SECRET VIEW KEY" />

            <ImageButton
                android:id="@+id/copy_wallet_secret_view_key_imagebutton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:contentDescription="@string/copy_wallet_s_private_view_key"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:src="@drawable/ic_content_copy_24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/wallet_secret_view_key_textview"
                app:layout_constraintTop_toBottomOf="@id/wallet_secret_view_key_header_textview" />

            <TextView
                android:id="@+id/wallet_public_view_key_header_textview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/public_view_key"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/copy_wallet_secret_view_key_imagebutton"
                app:layout_constraintVertical_bias="0.0" />

            <TextView
                android:id="@+id/wallet_public_view_key_textview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textSize="@dimen/text_medium"
                android:textColor="?attr/colorOnPrimary"
                app:layout_constraintBottom_toBottomOf="@id/copy_wallet_public_view_key_imagebutton"
                app:layout_constraintEnd_toStartOf="@id/copy_wallet_public_view_key_imagebutton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/copy_wallet_public_view_key_imagebutton"
                tools:text="PUBLIC VIEW KEY" />

            <ImageButton
                android:id="@+id/copy_wallet_public_view_key_imagebutton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:contentDescription="@string/copy_wallet_s_public_view_key"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:src="@drawable/ic_content_copy_24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/wallet_public_view_key_textview"
                app:layout_constraintTop_toBottomOf="@id/wallet_public_view_key_header_textview" />

            <TextView
                android:id="@+id/wallet_secret_spend_key_header_textview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/private_spend_key"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/copy_wallet_public_view_key_imagebutton"
                app:layout_constraintVertical_bias="0.0" />

            <TextView
                android:id="@+id/wallet_secret_spend_key_textview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textSize="@dimen/text_medium"
                android:textColor="?attr/colorOnPrimary"
                app:layout_constraintBottom_toBottomOf="@id/copy_wallet_secret_spend_key_imagebutton"
                app:layout_constraintEnd_toStartOf="@id/copy_wallet_secret_spend_key_imagebutton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/copy_wallet_secret_spend_key_imagebutton"
                tools:text="SECRET SPEND KEY" />

            <ImageButton
                android:id="@+id/copy_wallet_secret_spend_key_imagebutton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:contentDescription="@string/copy_wallet_s_private_spend_key"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:src="@drawable/ic_content_copy_24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/wallet_secret_spend_key_textview"
                app:layout_constraintTop_toBottomOf="@id/wallet_secret_spend_key_header_textview" />

            <TextView
                android:id="@+id/wallet_public_spend_key_header_textview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/public_spend_key"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/copy_wallet_secret_spend_key_imagebutton"
                app:layout_constraintVertical_bias="0.0" />

            <TextView
                android:id="@+id/wallet_public_spend_key_textview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textSize="@dimen/text_medium"
                android:textColor="?attr/colorOnPrimary"
                app:layout_constraintBottom_toBottomOf="@id/copy_wallet_public_spend_key_imagebutton"
                app:layout_constraintEnd_toStartOf="@id/copy_wallet_public_spend_key_imagebutton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/copy_wallet_public_spend_key_imagebutton"
                tools:text="PUBLIC SPEND KEY" />

            <ImageButton
                android:id="@+id/copy_wallet_public_spend_key_imagebutton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:contentDescription="@string/copy_wallet_s_public_spend_key"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:src="@drawable/ic_content_copy_24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/wallet_public_spend_key_textview"
                app:layout_constraintTop_toBottomOf="@id/wallet_public_spend_key_header_textview" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
