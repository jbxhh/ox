<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recycler_view_item_destination_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/padding_big">

    <ImageButton
        android:id="@+id/transaction_destination_remove_image_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/transaction_destination_amount_label_textview"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_delete"
        android:contentDescription="@string/recycler_view_item_transaction_destination_remove_content_description" />

    <TextView
        android:id="@+id/transaction_destination_amount_label_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textSize="@dimen/text_medium"
        android:textColor="@color/text_subtler"
        android:text="@string/recycler_view_item_transaction_destination_amount_label" />

    <EditText
        android:id="@+id/transaction_destination_amount_edittext"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/transaction_destination_amount_send_all_button"
        app:layout_constraintTop_toBottomOf="@id/transaction_destination_amount_label_textview"
        android:layout_marginTop="@dimen/padding_mini"
        android:background="@drawable/edittext_background"
        android:hint="@string/example_amount"
        android:inputType="numberDecimal" />

    <Button
        android:id="@+id/transaction_destination_amount_send_all_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/transaction_destination_amount_edittext"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/transaction_destination_amount_edittext"
        app:layout_constraintBottom_toBottomOf="@id/transaction_destination_amount_edittext"
        android:layout_marginStart="@dimen/padding_small"
        android:background="@drawable/button_background"
        android:text="@string/recycler_view_item_transaction_destination_send_all_label" />

    <TextView
        android:id="@+id/transaction_destination_recipient_name_label_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/transaction_destination_amount_edittext"
        android:layout_marginTop="@dimen/padding_small"
        android:textSize="@dimen/text_medium"
        android:textColor="@color/text_subtler"
        android:text="@string/recycler_view_item_transaction_destination_recipient_name_label" />

    <EditText
        android:id="@+id/transaction_destination_recipient_name_edittext"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/transaction_destination_address_book_button"
        app:layout_constraintTop_toBottomOf="@id/transaction_destination_recipient_name_label_textview"
        android:layout_marginTop="@dimen/padding_mini"
        android:background="@drawable/edittext_background"
        android:hint="@string/recycler_view_item_transaction_destination_recipient_name_hint"
        android:ellipsize="middle"
        android:singleLine="true" />

    <ImageButton
        android:id="@+id/transaction_destination_address_book_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/transaction_destination_recipient_name_edittext"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/transaction_destination_recipient_name_edittext"
        app:layout_constraintBottom_toBottomOf="@id/transaction_destination_recipient_name_edittext"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:background="@color/transparent"
        android:src="@drawable/address_book"
        android:contentDescription="@string/recycler_view_item_transaction_destination_address_book_description" />

    <TextView
        android:id="@+id/transaction_destination_address_label_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/transaction_destination_recipient_name_edittext"
        android:layout_marginTop="@dimen/padding_small"
        android:textSize="@dimen/text_medium"
        android:textColor="@color/text_subtler"
        android:text="@string/recycler_view_item_transaction_destination_address_label" />

    <EditText
        android:id="@+id/transaction_destination_address_edittext"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/transaction_destination_scan_image_button"
        app:layout_constraintTop_toBottomOf="@id/transaction_destination_address_label_textview"
        android:layout_marginTop="@dimen/padding_mini"
        android:background="@drawable/edittext_background"
        android:hint="@string/example_address"
        android:ellipsize="middle"
        android:singleLine="true" />

    <ImageButton
        android:id="@+id/transaction_destination_scan_image_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/transaction_destination_address_edittext"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/transaction_destination_address_edittext"
        app:layout_constraintBottom_toBottomOf="@id/transaction_destination_address_edittext"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:background="@color/transparent"
        android:src="@drawable/ic_scan"
        android:contentDescription="@string/recycler_view_item_transaction_destination_scan_content_description" />

    <TextView
        android:id="@+id/transaction_destination_donate_label_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/transaction_destination_address_edittext"
        app:layout_constraintTop_toBottomOf="@id/transaction_destination_address_edittext"
        android:layout_marginTop="@dimen/padding_mini"
        android:text="@string/recycler_view_item_transaction_destination_donate_label"
        android:textSize="@dimen/text_mini" />
</androidx.constraintlayout.widget.ConstraintLayout>
