<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/payment_request_activity_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/padding_big"
    tools:context="org.monfluo.wallet.activity.ActivityPaymentRequest">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_layout_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingBottom="@dimen/padding_big"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:id="@+id/back_imageview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:minHeight="32dp"
            android:minWidth="32dp"
            android:src="@drawable/left"
            android:contentDescription="@string/content_description_back" />

        <TextView
            android:id="@+id/header_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/back_imageview"
            app:layout_constraintTop_toTopOf="@id/back_imageview"
            app:layout_constraintBottom_toBottomOf="@id/back_imageview"
            android:text="@string/payment_request_header"
            android:textSize="@dimen/text_bigger"
            android:textStyle="bold"
            android:textColor="?attr/colorOnPrimary" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/network_status_fragment"
            android:name="org.monfluo.wallet.fragment.FragmentNetworkStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@color/transparent"
            tools:layout="@layout/fragment_network_status" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/payment_request_activity_main_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header_layout_view"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/address_qrcode_imageview"
            android:layout_width="256dp"
            android:layout_height="256dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@color/transparent"
            android:src="@drawable/monfluo"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/address_qrcode_icon_imageview"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:layout_constraintStart_toStartOf="@id/address_qrcode_imageview"
            app:layout_constraintEnd_toEndOf="@id/address_qrcode_imageview"
            app:layout_constraintTop_toTopOf="@id/address_qrcode_imageview"
            app:layout_constraintBottom_toBottomOf="@id/address_qrcode_imageview"
            android:background="@color/transparent"
            android:src="@drawable/monfluo"
            android:visibility="gone" />

        <TextView
            android:id="@+id/address_label_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/address_qrcode_imageview"
            android:layout_marginTop="@dimen/padding_big"
            android:text="@string/activity_payment_request_address_label"
            android:textSize="@dimen/text_medium"
            android:textColor="@color/text_subtler" />

        <TextView
            android:id="@+id/address_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/address_label_textview"
            android:layout_marginTop="@dimen/padding_mini"
            android:textSize="@dimen/text_big" />

        <TextView
            android:id="@+id/amount_label_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/address_textview"
            android:layout_marginTop="@dimen/padding_small"
            android:text="@string/activity_payment_request_amount_requested_label"
            android:textSize="@dimen/text_medium"
            android:textColor="@color/text_subtler" />

        <EditText
            android:id="@+id/amount_edittext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/amount_label_textview"
            android:layout_marginTop="@dimen/padding_mini"
            android:background="@drawable/edittext_background"
            android:inputType="numberDecimal"
            android:hint="@string/activity_payment_request_amount_requested_hint" />

        <TextView
            android:id="@+id/recipient_name_label_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/amount_edittext"
            android:layout_marginTop="@dimen/padding_small"
            android:text="@string/activity_payment_request_recipient_name_label"
            android:textSize="@dimen/text_medium"
            android:textColor="@color/text_subtler" />

        <EditText
            android:id="@+id/recipient_name_edittext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/recipient_name_label_textview"
            android:layout_marginTop="@dimen/padding_mini"
            android:background="@drawable/edittext_background"
            android:inputType="text"
            android:hint="@string/activity_payment_request_recipient_name_hint" />

        <TextView
            android:id="@+id/transaction_description_label_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/recipient_name_edittext"
            android:layout_marginTop="@dimen/padding_small"
            android:text="@string/activity_payment_request_transaction_description_label"
            android:textSize="@dimen/text_medium"
            android:textColor="@color/text_subtler" />

        <EditText
            android:id="@+id/transaction_description_edittext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/transaction_description_label_textview"
            android:layout_marginTop="@dimen/padding_mini"
            android:background="@drawable/edittext_background"
            android:inputType="textMultiLine"
            android:hint="@string/activity_payment_request_transaction_description_hint"
            android:maxLines="3" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
