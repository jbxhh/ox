<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_node_add_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/padding_big"
    android:scrollbars="none"
    tools:context="org.monfluo.wallet.activity.ActivityNodeAdd">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header_layout_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:paddingBottom="@dimen/padding_big"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/back_imageview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:minHeight="32dp"
                android:minWidth="32dp"
                android:src="@drawable/left"
                android:contentDescription="@string/content_description_back" />

            <TextView
                android:id="@+id/header_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/back_imageview"
                app:layout_constraintTop_toTopOf="@id/back_imageview"
                app:layout_constraintBottom_toBottomOf="@id/back_imageview"
                android:text="@string/add_node_header"
                android:textSize="@dimen/text_bigger"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimary" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/node_name_label_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header_layout_view"
            android:textSize="16sp"
            android:textColor="@color/text_subtler"
            android:text="@string/activity_node_add_node_name_label" />

        <EditText
            android:id="@+id/node_name_edittext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/node_name_label_textview"
            android:layout_marginTop="@dimen/padding_mini"
            android:background="@drawable/edittext_background"
            android:inputType="text"
            android:hint="@string/activity_node_add_node_name_placeholder" />

        <TextView
            android:id="@+id/node_address_label_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/node_name_edittext"
            android:layout_marginTop="@dimen/padding_small"
            android:textSize="16sp"
            android:textColor="@color/text_subtler"
            android:text="@string/activity_node_add_node_address_label" />

        <EditText
            android:id="@+id/node_address_edittext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/node_address_label_textview"
            android:layout_marginTop="@dimen/padding_mini"
            android:background="@drawable/edittext_background"
            android:inputType="text"
            android:hint="@string/activity_node_add_node_address_placeholder" />

        <CheckBox
            android:id="@+id/trusted_node_checkbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/node_address_edittext"
            android:layout_marginTop="@dimen/padding_small"
            android:text="@string/activity_node_add_node_daemon_trusted_label" />

        <Button
            android:id="@+id/node_network_type_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/trusted_node_checkbox"
            android:background="@drawable/button_small_background"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="NETWORK" />

        <TextView
            android:id="@+id/node_network_type_label_textview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@id/node_name_label_textview"
            app:layout_constraintEnd_toStartOf="@id/node_network_type_button"
            app:layout_constraintTop_toTopOf="@id/node_network_type_button"
            app:layout_constraintBottom_toBottomOf="@id/node_network_type_button"
            android:text="@string/activity_node_add_node_network_type_label"
            android:textColor="?attr/colorOnPrimary"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/node_username_label_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/node_network_type_button"
            android:layout_marginTop="@dimen/padding_small"
            android:textSize="16sp"
            android:textColor="@color/text_subtler"
            android:text="@string/activity_node_add_node_username_label" />

        <EditText
            android:id="@+id/node_username_edittext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/node_username_label_textview"
            android:layout_marginTop="@dimen/padding_mini"
            android:background="@drawable/edittext_background"
            android:inputType="text"
            android:hint="@string/activity_node_add_node_username_placeholder" />

        <TextView
            android:id="@+id/node_password_label_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/node_username_edittext"
            android:layout_marginTop="@dimen/padding_small"
            android:textSize="16sp"
            android:textColor="@color/text_subtler"
            android:text="@string/activity_node_add_node_password_label" />

        <EditText
            android:id="@+id/node_password_edittext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/node_password_label_textview"
            android:layout_marginTop="@dimen/padding_mini"
            android:background="@drawable/edittext_background"
            android:inputType="textPassword"
            android:hint="@string/activity_node_add_node_password_placeholder" />

        <Button
            android:id="@+id/node_add_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/node_password_edittext"
            android:layout_marginTop="@dimen/padding_big"
            android:background="@drawable/button_background"
            android:text="@string/activity_node_add_node_add_button" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
