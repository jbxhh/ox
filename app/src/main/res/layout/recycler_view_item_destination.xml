<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recycler_view_item_destination_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/padding_big">

    <ImageButton
        android:id="@+id/remove_output_imagebutton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_delete"
        android:contentDescription="@string/remove_recipient_from_transaction"
        tools:ignore="SpeakableTextPresentCheck" />

    <TextView
        android:id="@+id/transaction_destination_amount_label_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/remove_output_imagebutton"
        android:textSize="@dimen/text_medium"
        android:textColor="@color/text_subtler"
        android:text="Amount" />

    <EditText
        android:id="@+id/transaction_destination_amount_edittext"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/transaction_destination_amount_label_textview"
        android:layout_marginTop="@dimen/padding_mini"
        android:background="@drawable/edittext_background"
        android:hint="@string/example_amount"
        android:inputType="numberDecimal" />

    <TextView
        android:id="@+id/transaction_destination_address_label_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/transaction_destination_amount_edittext"
        android:layout_marginTop="@dimen/padding_small"
        android:textSize="@dimen/text_medium"
        android:textColor="@color/text_subtler"
        android:text="Address" />

    <EditText
        android:id="@+id/transaction_destination_address_edittext"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/scan_address_imagebutton"
        app:layout_constraintTop_toBottomOf="@id/transaction_destination_address_label_textview"
        android:layout_marginTop="@dimen/padding_mini"
        android:background="@drawable/edittext_background"
        android:hint="@string/example_address"
        android:ellipsize="middle"
        android:singleLine="true" />

    <ImageButton
        android:id="@+id/scan_address_imagebutton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/transaction_destination_address_edittext"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/transaction_destination_address_edittext"
        app:layout_constraintBottom_toBottomOf="@id/transaction_destination_address_edittext"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:background="@color/transparent"
        android:src="@drawable/ic_scan"
        android:contentDescription="@string/scan_qr_code_for_address_field"
        tools:ignore="SpeakableTextPresentCheck" />

    <TextView
        android:id="@+id/donate_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/transaction_destination_address_edittext"
        app:layout_constraintTop_toBottomOf="@id/transaction_destination_address_edittext"
        android:layout_marginTop="@dimen/padding_mini"
        android:text="@string/donate_label"
        android:textSize="@dimen/text_mini" />
</androidx.constraintlayout.widget.ConstraintLayout>
