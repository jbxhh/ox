<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/network_activity_view"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/standard_padding">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/header_layout_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingBottom="@dimen/additional_padding"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:id="@+id/back_imageview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:minHeight="32dp"
            android:minWidth="32dp"
            android:src="@drawable/left"
            android:contentDescription="@string/content_description_back" />

        <TextView
            android:id="@+id/header_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/back_imageview"
            app:layout_constraintTop_toTopOf="@id/back_imageview"
            app:layout_constraintBottom_toBottomOf="@id/back_imageview"
            android:text="@string/network_header"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnPrimary"/>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/node_status_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_layout_view"
        android:layout_marginVertical="@dimen/additional_padding"
        android:padding="@dimen/additional_padding"
        android:background="@drawable/card_background">

        <ImageView
            android:id="@+id/node_imageview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:padding="@dimen/additional_padding"
            android:background="@color/transparent"
            android:minWidth="40dp"
            android:minHeight="40dp"
            android:src="@drawable/server" />

        <TextView
            android:id="@+id/node_status_header_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/node_imageview"
            app:layout_constraintTop_toTopOf="@id/node_imageview"
            android:layout_marginHorizontal="@dimen/additional_padding"
            android:background="@color/transparent"
            android:textColor="?attr/colorOnPrimary"
            android:textStyle="bold"
            tools:text="Node header"/>

        <ProgressBar
            android:id="@+id/node_status_progress_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/node_imageview"
            app:layout_constraintTop_toBottomOf="@id/node_status_header_text_view"
            app:layout_constraintEnd_toEndOf="parent"
            android:paddingHorizontal="@dimen/additional_padding"
            android:background="@color/transparent"
            android:indeterminate="true"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>

        <TextView
            android:id="@+id/node_status_description_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/node_imageview"
            android:background="@color/transparent"
            android:textColor="?attr/colorOnPrimary"
            tools:text="Node status"/>

        <TextView
            android:id="@+id/node_status_updated_at_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/node_status_description_text_view"
            android:background="@color/transparent"
            tools:text="Updated at"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/wallet_status_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/node_status_layout"
        android:layout_marginVertical="@dimen/additional_padding"
        android:padding="@dimen/additional_padding"
        android:background="@drawable/card_background">

        <ImageView
            android:id="@+id/wallet_imageview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:padding="@dimen/additional_padding"
            android:background="@color/transparent"
            android:minWidth="40dp"
            android:minHeight="40dp"
            android:src="@drawable/wallet"
            android:textColor="?attr/colorOnPrimary" />

        <TextView
            android:id="@+id/wallet_status_header_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/wallet_imageview"
            app:layout_constraintTop_toTopOf="@id/wallet_imageview"
            android:layout_marginHorizontal="@dimen/additional_padding"
            android:background="@color/transparent"
            android:textColor="?attr/colorOnPrimary"
            android:textStyle="bold"
            tools:text="Wallet header"/>

        <ProgressBar
            android:id="@+id/wallet_status_progress_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/wallet_imageview"
            app:layout_constraintTop_toBottomOf="@id/wallet_status_header_text_view"
            app:layout_constraintEnd_toEndOf="parent"
            android:paddingHorizontal="@dimen/additional_padding"
            android:background="@color/transparent"
            android:indeterminate="true"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>

        <TextView
            android:id="@+id/wallet_status_description_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/wallet_imageview"
            android:background="@color/transparent"
            android:textColor="?attr/colorOnPrimary"
            tools:text="Wallet status"/>

        <TextView
            android:id="@+id/wallet_status_updated_at_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/wallet_status_description_text_view"
            android:background="@color/transparent"
            tools:text="Updated at"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>