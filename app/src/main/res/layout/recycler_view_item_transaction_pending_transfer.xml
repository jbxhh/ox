<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recycler_view_item_transaction_pending_transfer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/amount_label_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="@dimen/padding_small"
        android:text="@string/recycler_view_item_transaction_pending_amount_label"
        android:textSize="@dimen/text_medium"
        android:textColor="@color/text_subtler" />

    <TextView
        android:id="@+id/amount_textview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/amount_label_textview"
        android:layout_marginTop="@dimen/padding_mini"
        android:textSize="@dimen/text_big" />

    <TextView
        android:id="@+id/address_label_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/amount_textview"
        android:layout_marginTop="@dimen/padding_small"
        android:text="@string/recycler_view_item_transaction_pending_address_label"
        android:textSize="@dimen/text_medium"
        android:textColor="@color/text_subtler" />

    <TextView
        android:id="@+id/address_textview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/address_label_textview"
        android:layout_marginTop="@dimen/padding_mini"
        android:textSize="@dimen/text_big" />

    <TextView
        android:id="@+id/address_resolved_from_label_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/address_textview"
        android:layout_marginTop="@dimen/padding_small"
        android:text="@string/recycler_view_item_transaction_pending_address_resolved_from_label"
        android:textSize="@dimen/text_medium"
        android:textColor="@color/text_subtler" />

    <TextView
        android:id="@+id/address_resolved_from_textview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/dnssec_warning_icon_imageview"
        app:layout_constraintTop_toBottomOf="@id/address_resolved_from_label_textview"
        android:layout_marginTop="@dimen/padding_mini"
        android:textSize="@dimen/text_big" />

    <ImageView
        android:id="@+id/dnssec_warning_icon_imageview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/address_resolved_from_textview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/address_resolved_from_textview"
        app:layout_constraintBottom_toBottomOf="@id/address_resolved_from_textview"
        android:minHeight="32dp"
        android:minWidth="32dp"
        android:src="@android:drawable/stat_sys_warning"
        android:contentDescription="@string/content_description_dnssec_warning"
        android:visibility="gone"
        tools:visibility="visible"/>
</androidx.constraintlayout.widget.ConstraintLayout>
