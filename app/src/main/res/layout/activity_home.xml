<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:id="@+id/home_activity_view"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/no_transactions_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/balance_locked_textview"
        app:layout_constraintBottom_toTopOf="@id/transaction_history_recyclerview">

        <ImageView
            android:id="@+id/home_image_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/no_transactions_header_text_view"
            android:minWidth="40dp"
            android:minHeight="40dp"
            android:src="@drawable/home_image"
            android:contentDescription="@string/wallet" />

        <TextView
            android:id="@+id/no_transactions_header_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/no_transactions_text_text_view"
            android:paddingTop="@dimen/padding_small"
            android:gravity="center"
            android:text="@string/no_transactions_header"
            android:textStyle="bold"
            android:textSize="@dimen/text_bigger" />

        <TextView
            android:id="@+id/no_transactions_text_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:paddingTop="@dimen/padding_mini"
            android:gravity="center"
            android:text="@string/no_transactions_description"
            android:textSize="@dimen/text_medium" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/home_activity_main_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/transparent"
        android:paddingHorizontal="@dimen/padding_big"
        android:paddingTop="@dimen/padding_big"
        tools:context="org.monfluo.wallet.ActivityHome">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/wallet_card_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:padding="16dp"
            android:background="@drawable/wallet_card_background">

            <TextView
                android:id="@+id/wallet_name_textview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/network_status_fragment"
                app:layout_constraintTop_toTopOf="parent"
                android:background="@color/transparent"
                android:textSize="16sp"
                android:textColor="?attr/colorOnPrimary"
                android:text="@string/wallet_name_label"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/account_name_textview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/network_status_fragment"
                app:layout_constraintTop_toBottomOf="@id/wallet_name_textview"
                android:layout_marginTop="4dp"
                android:background="@color/transparent"
                android:textSize="20sp"
                android:textColor="?attr/colorOnPrimary"
                android:text="@string/account_name_label"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/balance_unlocked_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/account_name_textview"
                android:layout_marginTop="4dp"
                android:background="@color/transparent"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimary"
                android:text="@string/unlocked_balance_label"
                tools:text="123.456789123456 XMR" />

            <TextView
                android:id="@+id/balance_locked_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/balance_unlocked_textview"
                android:paddingTop="4dp"
                android:background="@color/transparent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimary"
                android:text="@string/locked_balance_label"
                tools:text="123.456789123456 XMR pending" />

            <TextView
                android:id="@+id/balance_frozen_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/balance_locked_textview"
                android:paddingTop="4dp"
                android:background="@color/transparent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimary"
                android:text="@string/frozen_balance_label"
                tools:text="123.456789123456 XMR frozen" />

            <ImageView
                android:id="@+id/enotes_imageview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/balance_unlocked_textview"
                app:layout_constraintTop_toTopOf="@id/balance_unlocked_textview"
                app:layout_constraintBottom_toBottomOf="@id/balance_unlocked_textview"
                android:layout_marginStart="12dp"
                android:background="@color/transparent"
                android:minWidth="32dp"
                android:minHeight="32dp"
                android:src="@drawable/enotes"
                android:contentDescription="@string/content_description_enotes" />

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/network_status_fragment"
                android:name="org.monfluo.wallet.fragment.FragmentNetworkStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toStartOf="@id/settings_imageview"
                app:layout_constraintTop_toTopOf="parent"
                android:paddingHorizontal="@dimen/padding_small"
                android:background="@color/transparent"
                tools:layout="@layout/fragment_network_status" />

            <ImageView
                android:id="@+id/settings_imageview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:background="@color/transparent"
                android:minWidth="32dp"
                android:minHeight="32dp"
                android:src="@drawable/settings"
                android:contentDescription="@string/content_description_application_settings" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/transaction_history_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/wallet_card_layout"
            tools:listitem="@layout/recycler_view_item_transaction"
            tools:visibility="visible" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/transparent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/receive_send_buttons_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:paddingHorizontal="@dimen/padding_big"
            android:paddingBottom="@dimen/padding_big"
            android:background="@drawable/transparent_gradient_background"
            android:accessibilityTraversalBefore="@id/transaction_history_recyclerview">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/receive_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:paddingVertical="12dp"
                android:text="@string/receive"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/icon_receive"
                app:iconGravity="textStart"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/send_button"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/send_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:paddingVertical="12dp"
                android:text="@string/send"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/icon_send"
                app:iconGravity="textStart"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/receive_button" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
