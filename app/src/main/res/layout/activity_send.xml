<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/send_activity_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/padding_big"
    tools:context="org.monfluo.wallet.ActivitySend">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_layout_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingBottom="@dimen/padding_big"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:id="@+id/back_imageview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:minHeight="32dp"
            android:minWidth="32dp"
            android:src="@drawable/left"
            android:contentDescription="@string/content_description_back" />

        <TextView
            android:id="@+id/header_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/back_imageview"
            app:layout_constraintTop_toTopOf="@id/back_imageview"
            app:layout_constraintBottom_toBottomOf="@id/back_imageview"
            android:text="@string/send_header"
            android:textSize="@dimen/text_bigger"
            android:textStyle="bold"
            android:textColor="?attr/colorOnPrimary" />

        <ImageButton
            android:id="@+id/add_output_imagebutton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@id/go_to_account_list_imageview"
            app:layout_constraintTop_toTopOf="@id/go_to_account_list_imageview"
            app:layout_constraintBottom_toBottomOf="@id/go_to_account_list_imageview"
            android:background="@color/transparent"
            android:src="@android:drawable/ic_input_add"
            android:contentDescription="@string/add_recipient_to_transaction" />

        <ImageView
            android:id="@+id/go_to_account_list_imageview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@id/network_status_fragment"
            app:layout_constraintTop_toTopOf="@id/network_status_fragment"
            app:layout_constraintBottom_toBottomOf="@id/network_status_fragment"
            android:layout_marginHorizontal="@dimen/padding_small"
            android:minHeight="32dp"
            android:minWidth="32dp"
            android:background="@drawable/account_background"
            android:src="@drawable/account"
            android:contentDescription="@string/content_description_account"
            android:visibility="gone" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/network_status_fragment"
            android:name="org.monfluo.wallet.fragment.FragmentNetworkStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@color/transparent"
            tools:layout="@layout/fragment_network_status" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/selected_enotes_textview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_layout_view"
        android:text="@string/activity_send_selected_enotes_value_text"
        android:textSize="@dimen/text_medium"
        android:visibility="gone"
        android:textColor="?attr/colorOnPrimary" />

    <TextView
        android:id="@+id/transaction_description_label_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/selected_enotes_textview"
        android:textSize="@dimen/text_medium"
        android:textColor="@color/text_subtler"
        android:text="@string/activity_send_description_label" />

    <EditText
        android:id="@+id/transaction_description_edittext"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/transaction_description_label_textview"
        android:layout_marginTop="@dimen/padding_mini"
        android:background="@drawable/edittext_background"
        android:hint="@string/activity_send_description_hint"
        android:inputType="textMultiLine"
        android:maxLines="3" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/transaction_destinations_recyclerview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/transaction_description_edittext"
        app:layout_constraintBottom_toTopOf="@id/transaction_fee_radiogroup"
        android:layout_marginTop="@dimen/padding_small"
        tools:listitem="@layout/recycler_view_item_transaction"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/transaction_fee_label_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/transaction_fee_radiogroup"
        app:layout_constraintTop_toTopOf="@id/transaction_fee_radiogroup"
        app:layout_constraintBottom_toBottomOf="@id/transaction_fee_radiogroup"
        android:layout_marginStart="@dimen/padding_big"
        android:text="@string/activity_send_fee_label"
        android:textSize="@dimen/text_medium" />

    <RadioGroup
        android:id="@+id/transaction_fee_radiogroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/transaction_fee_label_textview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/transaction_create_button"
        android:layout_marginStart="@dimen/padding_small"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/default_fee_radiobutton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:checked="true"
            android:text="@string/activity_send_fee_default_label"
            android:textSize="@dimen/text_medium" />

        <RadioButton
            android:id="@+id/medium_fee_radiobutton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:checked="false"
            android:text="@string/activity_send_fee_medium_label"
            android:textSize="@dimen/text_medium" />

        <RadioButton
            android:id="@+id/high_fee_radiobutton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:checked="false"
            android:text="@string/activity_send_fee_high_label"
            android:textSize="@dimen/text_medium" />
    </RadioGroup>

    <Button
        android:id="@+id/transaction_create_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="@dimen/padding_big"
        android:background="@drawable/button_background"
        android:text="@string/activity_send_transaction_create" />
</androidx.constraintlayout.widget.ConstraintLayout>
