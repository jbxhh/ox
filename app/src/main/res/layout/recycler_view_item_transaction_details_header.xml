<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recycler_view_item_transaction_details_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/transaction_type_label_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:text="@string/recycler_view_item_transaction_details_transaction_type_label"
        android:textSize="@dimen/text_medium"
        android:textColor="@color/text_subtler" />

    <TextView
        android:id="@+id/transaction_type_textview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/transaction_type_label_textview"
        android:layout_marginTop="@dimen/padding_mini"
        android:textSize="@dimen/text_big" />

    <TextView
        android:id="@+id/transaction_description_label_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/transaction_type_textview"
        android:layout_marginTop="@dimen/padding_small"
        android:text="@string/recycler_view_item_transaction_details_transaction_description_label"
        android:textSize="@dimen/text_medium"
        android:textColor="@color/text_subtler" />

    <TextView
        android:id="@+id/transaction_description_textview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/transaction_description_label_textview"
        android:layout_marginTop="@dimen/padding_mini"
        android:textSize="@dimen/text_big" />

    <EditText
        android:id="@+id/transaction_description_edittext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/transaction_description_label_textview"
        android:layout_marginTop="@dimen/padding_mini"
        android:background="@drawable/edittext_background"
        android:hint="@string/recycler_view_item_transaction_details_transaction_description_hint"
        android:textSize="@dimen/text_big"
        android:inputType="text"
        android:maxLines="1"
        android:imeOptions="actionDone"
        android:visibility="gone" />
</androidx.constraintlayout.widget.ConstraintLayout>
