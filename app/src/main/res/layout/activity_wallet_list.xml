<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_wallet_list"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/padding_big"
    tools:context="org.monfluo.wallet.WalletsActivity">

    <TextView
        android:id="@+id/application_name_header_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:text="@string/app_name"
        android:textAlignment="center"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnPrimary" />

    <ImageView
        android:id="@+id/monfluo_icon_imageview"
        android:layout_width="@dimen/qr_code_size"
        android:layout_height="@dimen/qr_code_size"
        android:layout_marginTop="32dp"
        android:src="@drawable/monfluo"
        android:contentDescription="@string/application_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/application_name_header_textview" />

    <ImageView
        android:id="@+id/application_settings_imageview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:contentDescription="@string/settings"
        android:minWidth="40dp"
        android:minHeight="40dp"
        android:src="@drawable/settings"
        app:layout_constraintBottom_toTopOf="@id/wallet_list_recyclerview"
        app:layout_constraintEnd_toEndOf="@id/wallet_list_recyclerview" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/wallet_list_recyclerview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/monfluo_icon_imageview"
        app:layout_constraintBottom_toTopOf="@id/create_or_import_wallet"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/padding_big"
        android:layout_marginBottom="@dimen/padding_big"
        app:layout_constraintHorizontal_bias="1.0" />

    <Button
        android:id="@+id/create_or_import_wallet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        android:background="@drawable/button_background"
        android:text="@string/new_wallet" />
</androidx.constraintlayout.widget.ConstraintLayout>
