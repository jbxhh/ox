<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/padding_small"
    android:padding="@dimen/padding_medium"
    android:background="@drawable/round_bg">

    <TextView
        android:id="@+id/enote_coin_label_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/enote_coin_textview"
        app:layout_constraintTop_toTopOf="parent"
        android:text="@string/coin"
        android:textColor="@color/oled_addressListColor"
        android:textSize="@dimen/text_big"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/enote_coin_textview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/enote_coin_label_textview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/enote_coin_label_textview"
        app:layout_constraintBottom_toBottomOf="@id/enote_coin_label_textview"
        android:layout_marginStart="@dimen/padding_small"
        android:textSize="@dimen/text_medium"
        android:textStyle="bold"
        android:ellipsize="middle"
        android:singleLine="true"
        tools:text="Outpoint" />

    <TextView
        android:id="@+id/enote_address_label_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/enote_address_textview"
        app:layout_constraintTop_toBottomOf="@id/enote_coin_label_textview"
        android:text="@string/address"
        android:textColor="@color/oled_addressListColor"
        android:textSize="@dimen/text_big"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/enote_address_textview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/enote_address_label_textview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/enote_address_label_textview"
        app:layout_constraintBottom_toBottomOf="@id/enote_address_label_textview"
        android:layout_marginStart="@dimen/padding_small"
        android:textSize="@dimen/text_medium"
        android:ellipsize="middle"
        android:singleLine="true"
        tools:text="Address" />

    <TextView
        android:id="@+id/enote_public_key_label_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/enote_public_key_textview"
        app:layout_constraintTop_toBottomOf="@id/enote_address_label_textview"
        android:text="@string/coin_public_key"
        android:textColor="@color/oled_addressListColor"
        android:textSize="@dimen/text_big"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/enote_public_key_textview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/enote_public_key_label_textview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/enote_public_key_label_textview"
        app:layout_constraintBottom_toBottomOf="@id/enote_public_key_label_textview"
        android:layout_marginStart="@dimen/padding_small"
        android:textSize="@dimen/text_medium"
        android:ellipsize="middle"
        android:singleLine="true"
        tools:text="Public Key" />

    <TextView
        android:id="@+id/enote_amount_label_textview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/enote_public_key_label_textview"
        android:text="@string/amount"
        android:textColor="@color/oled_addressListColor"
        android:textSize="@dimen/text_big"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/enote_amount_textview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/enote_amount_label_textview"
        app:layout_constraintTop_toBottomOf="@id/enote_amount_label_textview"
        android:textSize="@dimen/text_medium"
        tools:text="Amount" />

    <TextView
        android:id="@+id/enote_global_index_label_textview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/enote_public_key_label_textview"
        android:text="@string/coin_global_index"
        android:textColor="@color/oled_addressListColor"
        android:textSize="@dimen/text_big"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/enote_global_index_textview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@id/enote_global_index_label_textview"
        app:layout_constraintTop_toBottomOf="@id/enote_global_index_label_textview"
        android:textSize="@dimen/text_medium"
        tools:text="999999999999" />
</androidx.constraintlayout.widget.ConstraintLayout>
