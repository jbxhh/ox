<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="@dimen/additional_padding"
    android:padding="@dimen/medium_padding"
    android:background="@drawable/card_background"
    android:orientation="horizontal">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/send_or_receive_icon_image_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@color/transparent"
        android:layout_gravity="center"
        android:src="@drawable/icon_receive"
        android:contentDescription="@string/send_or_receive_icon_content_description" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/sent_or_received_label_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/send_or_receive_icon_image_view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/transaction_date_text_view"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@color/transparent"
        android:textColor="?attr/colorOnPrimary"
        android:text="@string/transaction_type_received"
        android:textStyle="bold"
        android:textSize="20sp"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/transaction_confirmations_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/send_or_receive_icon_image_view"
        app:layout_constraintTop_toBottomOf="@id/sent_or_received_label_text_view"
        app:layout_constraintBottom_toBottomOf="parent"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@color/transparent"
        android:textColor="@color/text_subtle"
        android:textSize="16sp"
        tools:text="Confirmations"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/transaction_amount_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/transaction_confirmations_text_view"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@color/transparent"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="18sp"
        android:fontFamily="monospace"
        tools:text="Received amount"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/transaction_date_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/transaction_amount_text_view"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@color/transparent"
        android:textColor="@color/text_subtle"
        android:textSize="16sp"
        tools:text="Transaction date"/>

</androidx.constraintlayout.widget.ConstraintLayout>
