<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recycler_view_item_transaction_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/padding_small"
    android:padding="@dimen/padding_medium"
    android:background="@drawable/card_background"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/send_or_receive_icon_image_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_gravity="center"
        android:background="@color/transparent"
        android:src="@drawable/icon_receive" />

    <TextView
        android:id="@+id/sent_or_received_label_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/send_or_receive_icon_image_view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/transaction_date_text_view"
        android:paddingHorizontal="@dimen/padding_medium"
        android:background="@color/transparent"
        android:text="@string/transaction_type_received"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="@dimen/text_big"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/transaction_confirmations_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/send_or_receive_icon_image_view"
        app:layout_constraintTop_toBottomOf="@id/sent_or_received_label_text_view"
        app:layout_constraintBottom_toBottomOf="parent"
        android:paddingHorizontal="@dimen/padding_medium"
        android:background="@color/transparent"
        android:textColor="@color/text_subtle"
        android:textSize="@dimen/text_medium"
        tools:text="Confirmations" />

    <TextView
        android:id="@+id/transaction_amount_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/transaction_confirmations_text_view"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@color/transparent"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="@dimen/text_medium"
        android:fontFamily="monospace"
        tools:text="Received amount" />

    <TextView
        android:id="@+id/transaction_date_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/transaction_amount_text_view"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@color/transparent"
        android:textColor="@color/text_subtle"
        android:textSize="@dimen/text_medium"
        tools:text="Transaction date" />

</androidx.constraintlayout.widget.ConstraintLayout>
