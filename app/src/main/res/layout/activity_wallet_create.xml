<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/create_wallet_activity_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/padding_big"
    android:background="@color/transparent"
    tools:context="org.monfluo.wallet.activity.ActivityWalletCreate">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/create_wallet_activity_main_view"
        android:layout_width="match_parent"
        android:layout_height="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header_layout_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:paddingBottom="@dimen/padding_big"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/back_imageview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:minHeight="32dp"
                android:minWidth="32dp"
                android:src="@drawable/left"
                android:contentDescription="@string/content_description_back" />

            <TextView
                android:id="@+id/header_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/back_imageview"
                app:layout_constraintTop_toTopOf="@id/back_imageview"
                app:layout_constraintBottom_toBottomOf="@id/back_imageview"
                android:text="@string/create_wallet_header"
                android:textSize="@dimen/text_bigger"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimary" />

            <ImageView
                android:id="@+id/application_settings_imageview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginHorizontal="@dimen/padding_small"
                android:background="@color/transparent"
                android:src="@drawable/settings"
                android:minWidth="32dp"
                android:minHeight="32dp"
                android:contentDescription="@string/settings" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/wallet_name_label_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header_layout_view"
            android:textSize="16sp"
            android:textColor="@color/text_subtler"
            android:text="@string/activity_wallet_create_wallet_name_label" />

        <EditText
            android:id="@+id/wallet_name_edittext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/wallet_name_label_textview"
            android:layout_marginTop="@dimen/padding_mini"
            android:background="@drawable/edittext_background"
            android:hint="@string/wallet_name"
            android:inputType="text"
            android:singleLine="true" />

        <TextView
            android:id="@+id/wallet_password_label_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/wallet_name_edittext"
            android:layout_marginTop="@dimen/padding_small"
            android:textSize="16sp"
            android:textColor="@color/text_subtler"
            android:text="@string/activity_wallet_create_wallet_password_label" />

        <EditText
            android:id="@+id/wallet_password_edittext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/wallet_password_label_textview"
            android:layout_marginTop="@dimen/padding_mini"
            android:background="@drawable/edittext_background"
            android:hint="@string/wallet_password_hint"
            android:inputType="textPassword"
            android:singleLine="true" />

        <EditText
            android:id="@+id/wallet_password_confirm_edittext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/wallet_password_edittext"
            android:layout_marginTop="@dimen/padding_small"
            android:background="@drawable/edittext_background"
            android:hint="@string/wallet_password_confirm_hint"
            android:inputType="textPassword"
            android:singleLine="true"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/advanced_settings_dropdown_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/wallet_password_confirm_edittext"
            app:layout_constraintHorizontal_bias="0.0"
            android:layout_marginTop="@dimen/padding_big"
            android:layout_marginBottom="@dimen/padding_small"
            android:text="@string/more_options"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="@dimen/text_big"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/advanced_settings_chevron_imageview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/advanced_settings_dropdown_textview"
            app:layout_constraintTop_toTopOf="@id/advanced_settings_dropdown_textview"
            app:layout_constraintBottom_toBottomOf="@id/advanced_settings_dropdown_textview"
            android:minWidth="24dp"
            android:minHeight="24dp"
            android:src="@drawable/ic_keyboard_arrow_down"
            app:tint="?attr/colorOnPrimary"
            android:contentDescription="@string/display_advanced_wallet_creation_options" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/more_options_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/advanced_settings_dropdown_textview">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/wallet_seed_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_big"
                app:layout_constraintTop_toTopOf="parent">

                <Button
                    android:id="@+id/seed_type_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:background="@drawable/button_small_background"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="12sp"
                    tools:text="SEED TYPE" />

                <TextView
                    android:id="@+id/seed_type_label_textview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/seed_type_button"
                    app:layout_constraintTop_toTopOf="@id/seed_type_button"
                    app:layout_constraintBottom_toBottomOf="@id/seed_type_button"
                    android:text="@string/seed_type"
                    android:textColor="?attr/colorOnPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/seed_type_desc_textview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/seed_type_button"
                    android:paddingTop="@dimen/padding_small"
                    android:paddingBottom="@dimen/padding_big"
                    android:textColor="?attr/colorOnPrimary"
                    tools:text="SEED TYPE DESCRIPTION" />

                <Button
                    android:id="@+id/network_type_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/seed_type_desc_textview"
                    android:background="@drawable/button_small_background"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="12sp"
                    tools:text="NETWORK" />

                <TextView
                    android:id="@+id/network_type_label_textview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/seed_type_label_textview"
                    app:layout_constraintEnd_toStartOf="@id/network_type_button"
                    app:layout_constraintTop_toTopOf="@id/network_type_button"
                    app:layout_constraintBottom_toBottomOf="@id/network_type_button"
                    android:text="@string/activity_wallet_create_wallet_network_type_label"
                    android:textColor="?attr/colorOnPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/wallet_seed_label_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/network_type_button"
                    android:layout_marginTop="@dimen/padding_small"
                    android:textSize="16sp"
                    android:textColor="@color/text_subtler"
                    android:text="@string/activity_wallet_create_wallet_seed_label" />

                <EditText
                    android:id="@+id/wallet_seed_edittext"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/wallet_seed_label_textview"
                    android:layout_marginTop="@dimen/padding_mini"
                    android:background="@drawable/edittext_background"
                    android:hint="@string/recovery_phrase_optional_polyseed"
                    android:inputType="textMultiLine"
                    android:lines="5"
                    android:maxLines="5" />

                <TextView
                    android:id="@+id/wallet_height_label_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/wallet_seed_edittext"
                    android:layout_marginTop="@dimen/padding_small"
                    android:textSize="16sp"
                    android:textColor="@color/text_subtler"
                    android:text="@string/activity_wallet_create_wallet_height_label" />

                <EditText
                    android:id="@+id/wallet_restore_height_edittext"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/wallet_height_label_textview"
                    android:layout_marginTop="@dimen/padding_mini"
                    android:background="@drawable/edittext_background"
                    android:hint="@string/restore_height_optional"
                    android:inputType="number"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/wallet_seed_offset_label_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/wallet_restore_height_edittext"
                    android:layout_marginTop="@dimen/padding_small"
                    android:textSize="16sp"
                    android:textColor="@color/text_subtler"
                    android:text="@string/activity_wallet_create_wallet_seed_offset_label" />

                <EditText
                    android:id="@+id/wallet_seed_offset_passphrase_edittext"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/wallet_seed_offset_label_textview"
                    android:layout_marginTop="@dimen/padding_mini"
                    android:background="@drawable/edittext_background"
                    android:hint="@string/wallet_seed_offset_passphrase" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <Button
            android:id="@+id/create_wallet_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/more_options_layout"
            android:background="@drawable/button_background"
            android:layout_marginTop="@dimen/padding_big"
            android:text="@string/create_wallet"
            android:enabled="false" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
