<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pending_transaction_activity_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/padding_big"
    tools:context="org.monfluo.wallet.ActivityTransactionPending">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_layout_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingBottom="@dimen/padding_big"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:id="@+id/back_imageview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:minHeight="32dp"
            android:minWidth="32dp"
            android:src="@drawable/left"
            android:contentDescription="@string/content_description_back" />

        <TextView
            android:id="@+id/header_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/back_imageview"
            app:layout_constraintTop_toTopOf="@id/back_imageview"
            app:layout_constraintBottom_toBottomOf="@id/back_imageview"
            android:text="@string/pending_transaction_header"
            android:textSize="@dimen/text_bigger"
            android:textStyle="bold"
            android:textColor="?attr/colorOnPrimary" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/network_status_fragment"
            android:name="org.monfluo.wallet.fragment.FragmentNetworkStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@color/transparent"
            tools:layout="@layout/fragment_network_status" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/address_label_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_layout_view"
        android:layout_marginTop="@dimen/padding_small"
        android:textSize="16sp"
        android:textColor="@color/text_subtler"
        android:text="@string/address" />

    <TextView
        android:id="@+id/address_textview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/address_label_textview"
        android:layout_marginTop="@dimen/padding_mini"
        android:text="@string/tx_address_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/address_resolved_from_label_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/address_textview"
        android:layout_marginTop="@dimen/padding_small"
        android:textSize="16sp"
        android:textColor="@color/text_subtler"
        android:text="@string/address_resolved_from" />

    <TextView
        android:id="@+id/address_resolved_from_textview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/address_resolved_from_label_textview"
        android:layout_marginTop="@dimen/padding_mini"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/amount_label_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/address_resolved_from_textview"
        android:layout_marginTop="@dimen/padding_small"
        android:textSize="16sp"
        android:textColor="@color/text_subtler"
        android:text="@string/amount" />

    <TextView
        android:id="@+id/amount_textview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/amount_label_textview"
        android:layout_marginTop="@dimen/padding_mini"
        android:text="@string/tx_amount_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/fee_label_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/amount_textview"
        android:layout_marginTop="@dimen/padding_small"
        android:textSize="16sp"
        android:textColor="@color/text_subtler"
        android:text="@string/fee" />

    <TextView
        android:id="@+id/fee_textview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fee_label_textview"
        android:layout_marginTop="@dimen/padding_mini"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/total_label_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fee_textview"
        android:layout_marginTop="@dimen/padding_small"
        android:textSize="16sp"
        android:textColor="@color/text_subtler"
        android:text="@string/total" />

    <TextView
        android:id="@+id/total_textview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/total_label_textview"
        android:layout_marginTop="@dimen/padding_mini"
        android:textSize="20sp"
        android:textStyle="bold" />

    <com.ncorti.slidetoact.SlideToActView
        android:id="@+id/send_tx_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:contentDescription="@string/slide_to_send_transaction"
        android:elevation="6dp"
        android:focusable="true"
        android:importantForAccessibility="yes"
        app:area_margin="10dp"
        app:border_radius="20dp"
        app:inner_color="@android:color/white"
        app:outer_color="@color/oled_colorSecondary"
        app:slider_height="72dp"
        app:slider_locked="false"
        app:text="@string/slide_to_send"
        app:text_size="@dimen/text_big" />
</androidx.constraintlayout.widget.ConstraintLayout>
