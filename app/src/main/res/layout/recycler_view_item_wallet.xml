<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recycler_view_item_wallet_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/padding_small"
    android:padding="@dimen/padding_medium"
    android:background="@drawable/card_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/wallet_wrapper_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/edit_wallet_imagebutton"
        android:background="@color/transparent">

        <ImageButton
            android:id="@+id/wallet_icon_imagebutton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:minWidth="40dp"
            android:minHeight="40dp"
            android:background="@drawable/highlighted_on_card_background"
            android:src="@drawable/logo_monero_alternative" />

        <TextView
            android:id="@+id/wallet_label_textview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/wallet_icon_imagebutton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/wallet_icon_imagebutton"
            app:layout_constraintBottom_toBottomOf="@id/wallet_icon_imagebutton"
            android:paddingStart="@dimen/padding_small"
            android:background="@color/transparent"
            android:textColor="?attr/colorOnPrimary"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageButton
        android:id="@+id/edit_wallet_imagebutton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:minWidth="40dp"
        android:minHeight="40dp"
        android:background="@color/transparent"
        android:src="@drawable/edit" />
</androidx.constraintlayout.widget.ConstraintLayout>
