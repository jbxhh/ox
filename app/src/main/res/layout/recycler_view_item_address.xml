<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recycler_view_item_address_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/padding_small"
    android:padding="@dimen/padding_medium"
    android:background="@drawable/card_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/address_wrapper_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/edit_address_imagebutton"
        android:background="@color/transparent">

        <RadioButton
            android:id="@+id/address_radiobutton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <ImageButton
            android:id="@+id/address_icon_imagebutton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/address_radiobutton"
            app:layout_constraintBottom_toBottomOf="@id/address_radiobutton"
            app:layout_constraintTop_toTopOf="@id/address_radiobutton"
            android:minWidth="40dp"
            android:minHeight="40dp"
            android:background="@drawable/highlighted_on_card_background"
            android:src="@drawable/logo_monero_alternative" />

        <TextView
            android:id="@+id/address_label_textview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/address_icon_imagebutton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/address_icon_imagebutton"
            android:paddingStart="@dimen/padding_small"
            android:background="@color/transparent"
            android:textColor="?attr/colorOnPrimary"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/address_balance_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/address_icon_imagebutton"
            app:layout_constraintBottom_toBottomOf="@id/address_icon_imagebutton"
            android:paddingStart="@dimen/padding_small"
            android:background="@color/transparent"
            android:textColor="?attr/colorOnPrimary" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageButton
        android:id="@+id/edit_address_imagebutton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/address_wrapper_layout"
        app:layout_constraintBottom_toBottomOf="@id/address_wrapper_layout"
        android:minWidth="40dp"
        android:minHeight="40dp"
        android:background="@color/transparent"
        android:src="@drawable/edit"
        android:contentDescription="@string/recycler_view_item_address_edit_content_description" />

    <TextView
        android:id="@+id/address_textview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/address_wrapper_layout"
        android:paddingTop="@dimen/padding_mini"
        android:background="@color/transparent"
        android:textColor="?attr/colorOnPrimary"
        tools:text="ADDRESS" />
</androidx.constraintlayout.widget.ConstraintLayout>
