<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/receive_activity_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/padding_big"
    tools:context="org.monfluo.wallet.activity.ActivityReceive">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_layout_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingBottom="@dimen/padding_big"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:id="@+id/back_imageview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:minHeight="32dp"
            android:minWidth="32dp"
            android:src="@drawable/left"
            android:contentDescription="@string/content_description_back" />

        <TextView
            android:id="@+id/header_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/back_imageview"
            app:layout_constraintTop_toTopOf="@id/back_imageview"
            app:layout_constraintBottom_toBottomOf="@id/back_imageview"
            android:text="@string/receive_header"
            android:textSize="@dimen/text_bigger"
            android:textStyle="bold"
            android:textColor="?attr/colorOnPrimary" />

        <ImageButton
            android:id="@+id/fresh_address_imageview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@id/go_to_account_list_imageview"
            app:layout_constraintTop_toTopOf="@id/go_to_account_list_imageview"
            app:layout_constraintBottom_toBottomOf="@id/go_to_account_list_imageview"
            android:layout_marginHorizontal="@dimen/padding_small"
            android:background="@android:color/transparent"
            android:visibility="invisible"
            android:contentDescription="@string/generate_fresh_wallet_address"
            android:minWidth="32dp"
            android:minHeight="32dp"
            android:src="@drawable/ic_refresh" />

        <ImageView
            android:id="@+id/go_to_account_list_imageview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@id/network_status_fragment"
            app:layout_constraintTop_toTopOf="@id/network_status_fragment"
            app:layout_constraintBottom_toBottomOf="@id/network_status_fragment"
            android:layout_marginHorizontal="@dimen/padding_small"
            android:minHeight="32dp"
            android:minWidth="32dp"
            android:background="@drawable/account_background"
            android:src="@drawable/account"
            android:contentDescription="@string/content_description_account" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/network_status_fragment"
            android:name="org.monfluo.wallet.fragment.FragmentNetworkStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@color/transparent"
            tools:layout="@layout/fragment_network_status" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/activity_receive_main_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header_layout_view"
        app:layout_constraintBottom_toBottomOf="parent"
        android:visibility="invisible">

        <ImageView
            android:id="@+id/address_qrcode_imageview"
            android:layout_width="256dp"
            android:layout_height="256dp"
            android:layout_marginTop="@dimen/padding_big"
            android:src="@drawable/monfluo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@color/transparent" />

        <ImageView
            android:id="@+id/address_qrcode_icon_imageview"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/monfluo"
            app:layout_constraintStart_toStartOf="@id/address_qrcode_imageview"
            app:layout_constraintEnd_toEndOf="@id/address_qrcode_imageview"
            app:layout_constraintTop_toTopOf="@id/address_qrcode_imageview"
            app:layout_constraintBottom_toBottomOf="@id/address_qrcode_imageview"
            android:background="@color/transparent" />

        <TextView
            android:id="@+id/address_label_textview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/copy_address_imagebutton"
            app:layout_constraintTop_toBottomOf="@id/address_qrcode_imageview"
            app:layout_constraintHorizontal_bias="0"
            android:layout_marginTop="@dimen/padding_small"
            android:layout_marginEnd="8dp"
            android:textSize="@dimen/text_medium"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?attr/colorOnPrimary"
            tools:text="LABEL" />

        <TextView
            android:id="@+id/address_textview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/copy_address_imagebutton"
            app:layout_constraintTop_toBottomOf="@id/address_label_textview"
            android:layout_marginTop="@dimen/padding_mini"
            android:layout_marginEnd="8dp"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnPrimary"
            tools:text="ADDRESS" />

        <ImageButton
            android:id="@+id/copy_address_imagebutton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/address_textview"
            app:layout_constraintTop_toBottomOf="@id/address_qrcode_imageview"
            android:layout_marginTop="16dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/copy_selected_wallet_address"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:src="@drawable/ic_content_copy_24dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/address_list_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/copy_address_imagebutton"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="@dimen/padding_big" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
