<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/receive_activity_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/standard_padding"
    tools:context="org.monfluo.wallet.ActivityReceive">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_layout_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingBottom="@dimen/additional_padding"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:id="@+id/back_imageview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:minHeight="32dp"
            android:minWidth="32dp"
            android:src="@drawable/left"
            android:contentDescription="@string/content_description_back" />

        <TextView
            android:id="@+id/header_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/back_imageview"
            app:layout_constraintTop_toTopOf="@id/back_imageview"
            app:layout_constraintBottom_toBottomOf="@id/back_imageview"
            android:text="@string/receive_header"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnPrimary"/>

        <ImageView
            android:id="@+id/go_to_account_list_imageview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@id/network_status_fragment"
            app:layout_constraintTop_toTopOf="@id/network_status_fragment"
            app:layout_constraintBottom_toBottomOf="@id/network_status_fragment"
            android:layout_marginHorizontal="@dimen/additional_padding"
            android:minHeight="32dp"
            android:minWidth="32dp"
            android:background="@drawable/account_background"
            android:src="@drawable/account"
            android:contentDescription="@string/content_description_account" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/network_status_fragment"
            android:name="org.monfluo.wallet.fragment.NetworkStatusFragment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@color/transparent"
            tools:layout="@layout/fragment_network_status"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/header_layout_view"
        tools:context="org.monfluo.wallet.ActivityReceive">

        <ImageView
            android:id="@+id/address_qrcode_imageview"
            android:layout_width="256dp"
            android:layout_height="256dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/monfluo"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@color/transparent"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/address_qrcode_icon_imageview"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/monfluo"
            android:visibility="invisible"
            app:layout_constraintStart_toStartOf="@id/address_qrcode_imageview"
            app:layout_constraintEnd_toEndOf="@id/address_qrcode_imageview"
            app:layout_constraintTop_toTopOf="@id/address_qrcode_imageview"
            app:layout_constraintBottom_toBottomOf="@id/address_qrcode_imageview"
            android:background="@color/transparent"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/address_textview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="middle"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:singleLine="true"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="invisible"
            app:layout_constraintBottom_toTopOf="@id/address_label_textview"
            app:layout_constraintEnd_toStartOf="@id/copy_address_imagebutton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/address_qrcode_imageview"
            tools:text="ADDRESS"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/address_label_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:textSize="14sp"
            android:visibility="invisible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/address_textview"
            tools:text="LABEL"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/copy_address_imagebutton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/copy_selected_wallet_address"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:src="@drawable/ic_content_copy_24dp"
            app:layout_constraintBottom_toTopOf="@id/address_list_recyclerview"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/address_textview"
            app:layout_constraintTop_toBottomOf="@id/address_qrcode_imageview" />

        <TextView
            android:id="@+id/address_list_label_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:ellipsize="middle"
            android:singleLine="true"
            android:text="@string/all_addresses"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/address_list_recyclerview"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageButton
            android:id="@+id/fresh_address_imageview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@id/address_list_recyclerview"
            app:layout_constraintBottom_toTopOf="@id/address_list_recyclerview"
            android:background="@android:color/transparent"
            android:contentDescription="@string/generate_fresh_wallet_address"
            android:minWidth="32dp"
            android:minHeight="32dp"
            android:src="@drawable/ic_refresh"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/address_list_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="256dp"
            android:layout_marginTop="64dp"
            android:background="@drawable/round_bg"
            android:clipToPadding="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/copy_address_imagebutton"
            app:layout_constraintVertical_bias="0.0" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>