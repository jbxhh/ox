<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/activity_wallet_change_password_layout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/padding_big">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_layout_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingBottom="@dimen/padding_big"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:id="@+id/back_imageview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:minHeight="32dp"
            android:minWidth="32dp"
            android:src="@drawable/left"
            android:contentDescription="@string/content_description_back" />

        <TextView
            android:id="@+id/header_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/back_imageview"
            app:layout_constraintTop_toTopOf="@id/back_imageview"
            app:layout_constraintBottom_toBottomOf="@id/back_imageview"
            android:text="@string/wallet_change_password_header"
            android:textSize="@dimen/text_bigger"
            android:textStyle="bold"
            android:textColor="?attr/colorOnPrimary" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/network_status_fragment"
            android:name="org.monfluo.wallet.android.fragment.FragmentNetworkStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@color/transparent"
            tools:layout="@layout/fragment_network_status" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/current_password_label_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_layout_view"
        android:textSize="@dimen/text_medium"
        android:textColor="@color/text_subtler"
        android:text="@string/activity_wallet_change_password_current_password_label" />

    <EditText
        android:id="@+id/current_password_edittext"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/current_password_label_textview"
        android:layout_marginTop="@dimen/padding_mini"
        android:background="@drawable/edittext_background"
        android:hint="@string/activity_wallet_change_password_current_password_hint"
        android:inputType="textPassword" />

    <TextView
        android:id="@+id/new_password_label_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/current_password_edittext"
        android:layout_marginTop="@dimen/padding_small"
        android:textSize="@dimen/text_medium"
        android:textColor="@color/text_subtler"
        android:text="@string/activity_wallet_change_password_new_password_label" />

    <EditText
        android:id="@+id/new_password_edittext"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/new_password_label_textview"
        android:layout_marginTop="@dimen/padding_mini"
        android:background="@drawable/edittext_background"
        android:hint="@string/activity_wallet_change_password_new_password_hint"
        android:inputType="textPassword" />

    <EditText
        android:id="@+id/new_password_confirm_edittext"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/new_password_edittext"
        android:layout_marginTop="@dimen/padding_small"
        android:background="@drawable/edittext_background"
        android:hint="@string/activity_wallet_change_password_new_password_confirm_hint"
        android:inputType="textPassword"
        android:visibility="gone"
        tools:visibility="visible" />

    <Button
        android:id="@+id/save_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/new_password_confirm_edittext"
        android:layout_marginTop="@dimen/padding_big"
        android:background="@drawable/button_background"
        android:text="@string/activity_wallet_change_password_save" />
</androidx.constraintlayout.widget.ConstraintLayout>
