<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".MoneroApplication"
        android:icon="@mipmap/launcher"
        android:roundIcon="@mipmap/launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".activity.ActivityStart"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activity.ActivityWalletList"
            android:windowSoftInputMode="adjustPan"
            android:exported="true">
        </activity>

        <activity
            android:name=".activity.ActivityWalletCreate"
            android:windowSoftInputMode="adjustPan"
            android:exported="true">
        </activity>

        <activity
            android:name=".activity.ActivityHome"
            android:exported="true">
        </activity>

        <activity
            android:name=".activity.ActivitySend"
            android:windowSoftInputMode="adjustPan"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="monero" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activity.ActivityReceive"
            android:exported="true">
        </activity>

        <activity
            android:name=".activity.ActivityPaymentRequest"
            android:exported="true">
        </activity>

        <activity
            android:name=".activity.ActivityApplicationSettings"
            android:exported="true">
        </activity>

        <activity
            android:name=".activity.ActivityWalletSettings"
            android:exported="true">
        </activity>

        <activity
            android:name=".activity.ActivityWalletChangePassword"
            android:exported="true">
        </activity>

        <activity
            android:name=".activity.ActivityTransactionDetails"
            android:exported="true">
        </activity>

        <activity
            android:name=".activity.ActivityEnoteList"
            android:exported="true">
        </activity>

        <activity
            android:name=".activity.ActivityNetwork"
            android:exported="true">
        </activity>

        <activity
            android:name=".activity.ActivityTransactionPending"
            android:exported="true">
        </activity>

        <activity
            android:name=".activity.ActivityAccountList"
            android:exported="true">
        </activity>

        <activity
            android:name=".activity.ActivityAccountAdd"
            android:exported="true">
        </activity>

        <activity
            android:name=".activity.ActivityAccountDetails"
            android:exported="true">
        </activity>

        <activity
            android:name=".activity.ActivityAddressDetails"
            android:exported="true">
        </activity>

        <activity
            android:name=".activity.ActivityNodeList"
            android:exported="true">
        </activity>

        <activity
            android:name=".activity.ActivityNodeAdd"
            android:exported="true">
        </activity>

        <activity
            android:name=".activity.ActivityNodeDetails"
            android:exported="true">
        </activity>

        <activity
            android:name=".activity.ActivityWalletSecrets"
            android:exported="true">
        </activity>

        <activity
            android:name=".activity.ActivityWalletDetails"
            android:exported="true">
        </activity>

        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="unspecified"
            android:stateNotNeeded="true"
            tools:replace="android:screenOrientation" />

        <service
            android:name=".service.wallet.WalletService"
            android:description="@string/service_description"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:label="Monero Wallet Service">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps app in sync with the blockchain" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>
    </application>

</manifest>
